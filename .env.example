# Public contact-form endpoint. Do not put bot tokens or other secrets here.
VITE_CONTACT_ENDPOINT=/api/contact
VITE_MANDATE_ENDPOINT=/api/mandate

# Server-only Telegram credentials. Never prefix these with VITE_.
TELEGRAM_BOT_TOKEN=123456789:replace_with_real_bot_token
TELEGRAM_CHAT_ID=-1001234567890

# Administrator contact details shown on /contact.
VITE_ADMIN_ONE_NAME=Admin ismi
VITE_ADMIN_ONE_PHONE=+998 90 000 00 00
VITE_ADMIN_TWO_NAME=Admin ismi
VITE_ADMIN_TWO_PHONE=+998 91 000 00 00

# Official social profile URLs.
VITE_TELEGRAM_URL=https://t.me/your_username
VITE_INSTAGRAM_URL=https://instagram.com/your_username

# Public production domain used for canonical links.
VITE_SITE_URL=https://your-domain.uz

# Admin panel, database and image storage (Supabase Project Settings > API).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only key used for private mandate and inquiry records. Never prefix with VITE_.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Browser push notifications. Generate once with: npm run push:keys
VITE_VAPID_PUBLIC_KEY=replace_with_public_vapid_key
VAPID_PRIVATE_KEY=replace_with_private_vapid_key
VAPID_SUBJECT=mailto:admin@your-domain.uz
